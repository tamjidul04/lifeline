# Neon pooled connection string (app runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require&pgbouncer=true&connect_timeout=15"
# Neon direct connection string (migrations only)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/neondb?sslmode=require"
# Random 32+ char secret for signing session cookies
SESSION_SECRET="change-me-to-a-long-random-string"
# Password given to all demo accounts by the seed script (min 8 chars)
SEED_PASSWORD="choose-a-demo-password"
